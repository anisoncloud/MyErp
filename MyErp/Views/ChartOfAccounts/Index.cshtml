@model IEnumerable<MyErp.Models.ChartOfAccount>

<h2>Chart of Accounts</h2>
<a asp-action="Create" class="btn btn-primary">+ Add Account</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Type</th>
            <th>Balance</th>
            <th>Parent Account</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AccountCode</td>
                <td>@item.AccountName</td>
                <td>@item.AccountType</td>
                <td>@item.OpeningBalance</td>
                <td>@item.ParentAccount?.AccountName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AccountId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.AccountId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
