@{
}
<form asp-action="Delete">
    <input type="hidden" asp-for="@Model.AccountId" />
    <table class="table table-striped">
        <tr>
        <td>Account Name</td>
        <td>@Model.AccountName</td>
        </tr>
        <tr>
        <td>Account Code</td>
        <td>@Model.AccountCode</td>
        </tr>        
    </table>
    <button type="submit" class="btn btn-danger">Delete</button>
</form>