@model MyErp.Models.PublicHolidays
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h1>Public Holidays</h1>
<form asp-action="Create">
    @Html.AntiForgeryToken()
    <div class="text-danger" asp-validation-summary="ModelOnly"></div>
    <div class="row mb-5">
        <div class="col">
            <div class="md-3">
                <label class="form-label" asp-for="HolidayName"></label>
                <input class="form-control" asp-for="HolidayName" />
                <span class="text-danger" asp-validation-for="HolidayName"></span>
            </div>            
            <div class="md-3">
                <label class="form-label" asp-for="HolidayDate"></label>
                <input type="date" class="form-control" asp-for="HolidayDate" />
                <span class="text-danger" asp-validation-for="HolidayDate"></span>
            </div>
            <div class="md-3">
                <label class="form-label" asp-for="Description"></label>
                <input class="form-control" asp-for="Description" />
                <span class="text-danger" asp-validation-for="Description"></span>
            </div>
            <div class="form-check">                
                <input class="form-check-input" type="checkbox" asp-for="IsPublicHoliday">
                <label class="form-check-label" for="flexCheckDefault">
                    Is Public Holiday?
                </label>
            </div>
        </div>
        
    </div>
    <button type="submit" value="Create" class="btn btn-primary">Create</button>
</form>
<a class="" asp-action="Index">See All Public Holidays</a>