@model MyErp.ViewModels.ProjectViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<form asp-action="PeopleAssign" method="post">
    <input type="hidden" asp-for="ProjectId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @Html.AntiForgeryToken()
    
    <h4>Assign Project to Developer: @Model.ProjectName </h4>
    <div class="mb-3">
        <label asp-for="@Model.ProjectName" class="control-label"></label>
        <input asp-for="@Model.ProjectName" class="form-control" />
        <span asp-validation-for="@Model.ProjectName" class="text-danger"></span>
    </div>

    <h4>Select Developer</h4>
    @foreach (var people in Model.AllPeoples)
    {
        <div class="form-check form-check-inline">
            <input type="checkbox"
                   class="form-check-input"
                   value="@people.Value"
                   id=""
                   name="SelectedPeopleIds"
                   @(Model.SelectedPeopleIds.Contains(int.Parse(people.Value)) ? "checked" : "") />
            <label class="form-check-label">
                @people.Text
            </label>
        </div>
    }
    <p></p>
   
    <button type="submit" class="btn btn-primary w-50">Update</button>
</form>