@model IEnumerable<MyErp.Models.Project>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h1>Project</h1>
<a asp-action="Create">Project Create</a>
<table class="table table-striped">
    <tr>
        <th>Project Name</th>
        <th>Pepple Assigned</th>
        <th>Pepple Assigned</th>
        <th>Action</th>
    </tr>
    @foreach (var project in Model)
        {
    <tr>
        <td>@project.Name</td>
        <td>@project.PeopleProjects.Count()</td>
            <td>@foreach(var people in project.PeopleProjects)
                {
                    @people.People.Name;
                }
            </td>
            <td>
                <a asp-action="PeopleAssign" asp-route-id="@project.ID">Project Assign</a>
            </td>   
    </tr>
    }
</table>