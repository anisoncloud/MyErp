@model IEnumerable<MyErp.Models.Domain>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h1 class="">All Domains</h1>
<p><a asp-action="Create">Create Domain</a></p>
<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Company</th>
            <th scope="col">Domain</th>
            <th scope="col">Regiter</th>
            <th scope="col">Updated</th>
            <th scope="col">Year</th>
            <th scope="col">Expire</th>
            <th scope="col">IP</th>
            <th scope="col">Hosing</th>
            <th scope="col">NS</th>
            <th scope="col">Analytics</th>
            <th scope="col">Comments</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @{
            var serial = 1;
        }
        @foreach (var domain in Model)
        {
            <tr>
                <th scope="row">@serial</th>
                <td>@domain.CompanyId</td>
                <td>@domain.DomainName</td>
                <td>@domain.RegistarDate</td>
                <td></td>
                <td>@domain.ForYear</td>
                <td>@domain.ExpireDate</td>
                <td>@domain.IpAddress</td>
                <td>@domain.Hosting</td>
                <td>@domain.Dns</td>
                <td>@domain.Analytics</td>
                <td>@domain.Comments</td>
                <td>
                    <a asp-action="Edit" asp-controller="LeaveRequest" asp-route-id="@domain.Id" class="navlink">Edit</a>
                    <a asp-action="Delete" asp-controller="LeaveRequest" asp-route-id="@domain.Id" class="navlink">Delete</a>
                </td>
            </tr>
            serial++;
        }
    </tbody>
</table>