@model IEnumerable<MyErp.Models.EmployeeAttendance>

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Name</th>
            <th scope="col">Id</th>
            <th scope="col">Date</th>
            <th scope="col">InTime</th>
            <th scope="col">OutTime</th>
        </tr>
    </thead>
    <tbody>
        @{
            var serial = 1;
        }
        @foreach (var user in Model)
        {
            <tr>
                <th scope="row">@serial</th>
                <td>@user.Users.FullName</td>
                <td>@user.CustomEmployeeId </td>
                <td>@user.InTime?.ToString("dd/MM/yyyy")</td>
                <td>@Html.DisplayFor(m => user.InTime)</td>
                <td>@Html.DisplayFor(m => user.OutTime)</td>
            </tr>
            serial++;
        }
    </tbody>
</table>