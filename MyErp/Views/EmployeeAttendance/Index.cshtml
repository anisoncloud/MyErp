@model IEnumerable<MyErp.Models.EmployeeAttendance>

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Name</th>
            <th scope="col">Id</th>
            <th scope="col">Company</th>
            <th scope="col">Department</th>
            <th scope="col">InTime</th>
            <th scope="col">OutTime</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @{
            var serial = 1;
        }
        @foreach (var user in Model)
        {
            <tr>
                <th scope="row">@serial</th>
                <td>@user.Users.FullName</td>
                <td>@user.CustomEmployeeId </td>
                <td>@user.Users.Company.Name </td>
                <td>@user.Users.Department.Name</td>
                <td>@Html.DisplayFor(m => user.InTime)</td>
                <td>@Html.DisplayFor(m => user.OutTime)</td>
                <td><a asp-action="Details" asp-controller="EmployeeAttendance" asp-route-id="@user.EmployeeId">Details</a></td>
            </tr>
            serial++;
        }
    </tbody>
</table>
@{
    ViewData["Title"] = "Monthly Working Day Table";

    DateTime today = DateTime.Today;
    DateTime selectedDate = today;

    if (!string.IsNullOrEmpty(Context.Request.Query["selectedDate"]))
    {
        DateTime.TryParse(Context.Request.Query["selectedDate"], out selectedDate);
    }

    // Restrict to current month
    if (selectedDate.Month != today.Month || selectedDate.Year != today.Year)
    {
        selectedDate = today;
    }

    int daysToShow = selectedDate.Day;
}

<form method="get" class="mb-3">
    <label>Select Date:</label>
    <input type="date"
           name="selectedDate"
           value="@selectedDate.ToString("yyyy-MM-dd")"
           max="@today.ToString("yyyy-MM-dd")"
           class="form-control w-25 d-inline"
           onchange="this.form.submit()" />
</form>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Date</th>
            <th>Day Name</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @for (int day = 1; day <= daysToShow; day++)
        {
            DateTime date = new DateTime(today.Year, today.Month, day);

            <tr>
                <td>@day</td>
                <td>@date.ToString("dd MMM yyyy")</td>
                <td>@date.ToString("dddd")</td>
                <td>—</td>
            </tr>
        }
    </tbody>
</table>
