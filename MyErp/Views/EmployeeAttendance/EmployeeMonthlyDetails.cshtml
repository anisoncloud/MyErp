@model IEnumerable<MyErp.ViewModels.DailyAttendanceViewModel>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>In Time</th>
            <th>Out Time</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Date.ToString("dd-MMM-yyyy")</td>
                <td>@item.InTime</td>
                <td>@(item.OutTime?.ToString(@"hh\:mm") ?? "-")</td>
                <td>
                    <span class="badge
                        @(item.Status == "Present" ? "bg-success" :
                          item.Status == "Absent" ? "bg-danger" :
                          "bg-warning")">
                        @item.Status
                    </span>
                </td>
            </tr>
        }
    </tbody>
</table>
