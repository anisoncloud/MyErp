@model IEnumerable<MyErp.ViewModels.MonthlyAttendanceViewModel>

@{
    var maxDate = DateTime.Now.ToString("yyyy-MM-dd");
}

<form method="get" asp-action="MonthlyAttendance" id="dateForm" class="mb-3">
    <label>Select Date:</label>
    <input type="date" id="datePicker"
           name="selectedDate"           
           max="@maxDate"
           class="form-control w-25 d-inline"
           value="@(((DateTime)ViewBag.SelectedDate).ToString("yyyy-MM-dd"))"
           />
    <input type="hidden" name="year" id="year" />
    <input type="hidden" name="month" id="month" />
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>EmployeeID</th>
            <th>Custom Employee Id</th>
            <th>Employee</th>
            <th>Working Days</th>
            <th>Present Days</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EmployeeId</td>
                <td>@item.CustomEmployeeId</td>
                <td>@item.EmployeeName</td>
                <td>@item.WorkingDaysInAMonth</td>
                <td>@item.PresentDays</td>
                <td><a asp-action="EmployeeMonthlyDetails" asp-controller="EmployeeAttendance" asp-route-employeeId="@item.EmployeeId" asp-route-year="@(((DateTime)ViewBag.SelectedDate).ToString("yyyy"))" asp-route-month="@(((DateTime)ViewBag.SelectedDate).ToString("MM"))">Details</a></td>
            </tr>
        }
    </tbody>
</table>

        @section AttendanceScript{
            <script>
                document.getElementById('datePicker').addEventListener('change', function(){
                    const date = new Date(this.value);
                    document.getElementById('year').value = date.getFullYear();
                    document.getElementById('month').value = date.getMonth()+1;
                    document.getElementById('dateForm').submit();
                    //document.getElementById('datePicker').value=date;
                });
            </script>
        }