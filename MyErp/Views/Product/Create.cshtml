@model MyErp.ViewModels.ProductViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<form method="post" asp-action="Create">
    <div class="form-group">
        <label>@Html.DisplayNameFor(Model=>Model.Name)</label>
        <input asp-for="@Model.Name" />
    </div>
    <div class="form-group">
        <label>Select Category</label>
        @foreach(var category in Model.AllMainCategories)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       name="SelectedMainCategoryIds"
                       value="@category.Value" />
                       <label class="form-check-label">@category.Text</label>
            </div>
        }
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>