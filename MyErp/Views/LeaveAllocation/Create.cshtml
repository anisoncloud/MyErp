@model MyErp.Models.LeaveAllocation

<h4>Set Leave Allocation for: @Model.Users.FullName </h4>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @Html.AntiForgeryToken()   

    
    <div class="mb-3">
        <label asp-for="Sick" class="control-label"></label>
        <input asp-for="Sick" class="form-control" />
        <span asp-validation-for="Sick" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Casual" class="control-label"></label>
        <input asp-for="Casual" class="form-control" />
        <span asp-validation-for="Casual" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Earned" class="control-label"></label>
        <input asp-for="Earned" class="form-control" />
        <span asp-validation-for="Earned" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Maternity" class="control-label"></label>
        <input asp-for="Maternity" class="form-control" />
        <span asp-validation-for="Maternity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Paternity" class="control-label"></label>
        <input asp-for="Paternity" class="form-control" />
        <span asp-validation-for="Paternity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Pilgrimage" class="control-label"></label>
        <input asp-for="Pilgrimage" class="form-control" />
        <span asp-validation-for="Pilgrimage" class="text-danger"></span>
    </div>

    
    <button type="submit" value="Create" class="btn btn-primary w-50">Create</button>
</form>