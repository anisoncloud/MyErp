@{
}


<h1 class="">Leave Report for : @DateTime.Today.Year</h1>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th colspan="2">Sick</th>
            <th colspan="2">Casual</th>
            <th colspan="2">Earned(CY)</th>
            <th colspan="2">Earned(CF)</th>
            <th colspan="2">Paternity</th>
            <th colspan="2">Pilgr</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td></td>
            <td></td>
            <td>Allow</td>
            <td>Enjoyed</td>
            <td>Allow</td>
            <td>Enjoyed</td>
            <td>Allow</td>
            <td>Enjoyed</td>
            <td>Allow</td>
            <td>Enjoyed</td>
            <td>Allow</td>
            <td>Enjoyed</td>
            <td>Allow</td>
            <td>Enjoyed</td>
        </tr>
        <tr>
            <td>@Model.Users.FullName</td>
            <td></td>
            <td>@Model.LeaveAllocation.Sick</td>
            <td>@Model.CalculateTotalSick()</td>
            <td>@Model.LeaveAllocation.Casual</td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
