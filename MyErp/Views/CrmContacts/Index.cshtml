@* @model IEnumerable<MyErp.Models.CrmContact> *@
@model IEnumerable<MyErp.Models.CrmCompany>
@* @model IEnumerable<MyErp.ViewModels.CrmCompanyViewModel> *@
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@section Styles {
    <link href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.css" rel="stylesheet" type="text/css" />
}
<h1 class="display-3">Contacts</h1> <a asp-action="Create" asp-controller="CrmContacts">Create</a>
<table id="example" class="table table-striped">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Logo</th>
                <th scope="col">Company Name</th>
                <th scope="col">Contact</th>
                              
            </tr>
        </thead>
        <tbody>
            @{
                var serial = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <th scope="row">@serial</th>
                    <td></td>
                    <td>@item.Name</td>
                <td>
                    <table class="table table-bordered table-fixed">
                        @foreach (var contact in item.CrmContacts)
                        {

                            <tr>
                                <td>@contact.Name</td>
                                <td>@contact.Phone</td>
                                <td>@contact.Email</td>
                                <td>@contact.Designation</td>
                            </tr>
                        }
                    </table>
                    </td>                    
                </tr>
                serial++;
            }
        </tbody>
    </table>
@section Scripts {
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.js"></script>
    <script>
        new DataTable('#example');
    </script>


}