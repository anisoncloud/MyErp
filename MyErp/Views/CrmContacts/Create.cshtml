@model MyErp.ViewModels.CrmContactViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h1>Edit Contact</h1>
<form asp-action="Create">
    @Html.AntiForgeryToken()
    <div class="text-danger" asp-validation-summary="ModelOnly"></div>
    <div class="md-3">
        <label class="form-label" asp-for="CrmCompanyId"></label> <a asp-action="Create" asp-controller="CrmCompany">Create Company</a>
        <select class="form-control" asp-for="CrmCompanyId" asp-items="Model.CrmCompany">
            <option value="">---Select Company---</option>
        </select>
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>
    <div class="md-3">
        <label class="form-label" asp-for="Name"></label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>
    <div class="text-danger" asp-validation-summary="ModelOnly"></div>
    <div class="md-3">
        <label class="form-label" asp-for="Email"></label>
        <input class="form-control" asp-for="Email" />
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>
    <div class="md-3">
        <label class="form-label" asp-for="Phone"></label>
        <input class="form-control" asp-for="Phone" />
        <span class="text-danger" asp-validation-for="Phone"></span>
    </div>
    <div class="md-3">
        <label class="form-label" asp-for="Photo"></label>
        <input class="form-control" asp-for="Photo" />
        <span class="text-danger" asp-validation-for="Photo"></span>
    </div>
    <div class="md-3">
        <label class="form-label" asp-for="Comments"></label>
        <input class="form-control" asp-for="Comments" />
        <span class="text-danger" asp-validation-for="Comments"></span>
    </div>
    <button type="submit" value="Create" class="btn btn-primary">Create</button>
</form>