@model IEnumerable<MyErp.Models.JournalEntry>

<h2>Journal Entries</h2>
<a asp-action="Create" class="btn btn-primary">+ New Entry</a>

<table class="table table-bordered mt-2">
    <thead>
        <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Lines</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry.EntryDate.ToString("dd/MM/yyyy")</td>
                <td>@entry.Description</td>
                <td>
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Account</th>
                                <th>Debit</th>
                                <th>Credit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in entry.Lines)
                            {
                                <tr>
                                    <td>@line.Account?.AccountName</td>
                                    <td>@line.Debit</td>
                                    <td>@line.Credit</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
            </tr>
        }
    </tbody>
</table>
