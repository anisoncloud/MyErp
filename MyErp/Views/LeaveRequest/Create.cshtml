@{
}

@model MyErp.ViewModels.LeaveRequestViewModel

<h2>Create Leave Request</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="EmpId"></label>
        <input asp-for="EmpId" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="LeaveType"></label>
        <select asp-for="LeaveType" class="form-control">
            <option value="">---Select Leave---</option>
            <option value="Sick">Sick Leave</option>
            <option value="Casual">Casual Leave</option>
            <option value="Earned">Earned Leave</option>
            <option value="Paternity">Paternity Leave</option>
            <option value="Maternity">Maternity Leave</option>
        </select>
        <span class="text-danger" asp-validation-for="LeaveType"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span class="text-danger" asp-validation-for="StartDate"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span class="text-danger" asp-validation-for="EndDate"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Days"></label>
        <input asp-for="Days" class="form-control" />
        <span class="text-danger" asp-validation-for="Days"></span>
    </div><div class="mb-3">
        <label asp-for="ManagerEmail"></label>
        <input asp-for="ManagerEmail" class="form-control" />
        <span class="text-danger" asp-validation-for="ManagerEmail"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Comment"></label>
        <textarea asp-for="Comment" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Submit Request</button>
</form>
