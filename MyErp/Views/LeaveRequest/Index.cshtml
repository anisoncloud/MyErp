@model IEnumerable<MyErp.Models.LeaveRequest>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Name</th>
            <th scope="col">Department</th>
            <th scope="col">From Date</th>
            <th scope="col">To Date</th>
            <th scope="col">Days</th>
            <th scope="col">Type</th>
            <th scope="col">Reason</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @{
            var serial = 1;
        }
        @foreach (var lr in Model)
        {
            <tr>
                <th scope="row">@serial</th>
                <td>Name</td>
                <td>Department</td>
                <td>@lr.StartDate</td>
                <td>@lr.EndDate</td>
                <td>@lr.Days</td>
                <td>@lr.LeaveType</td>
                <td>@lr.Comment</td>
                <td><a asp-action="Edit" asp-controller="LeaveRequest" asp-route-id="@lr.ID" class="navlink">Edit</a>                      
                        <a asp-action="Delete" asp-controller="LeaveRequest" asp-route-id="@lr.ID" class="navlink">Delete</a>                    
                </td>
            </tr>
            serial++;
        }
    </tbody>
</table>