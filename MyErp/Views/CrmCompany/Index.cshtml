@model IEnumerable<MyErp.Models.CrmCompany>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h1>All Companies</h1>
<a asp-action="Create">Create Company</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @{
            var serial = 1;
        }
        @foreach (var company in Model)
        {
        <tr>
            <td>@serial</td>
            <td>@company.Name</td>
            <td>@company.CompanyPhone</td>
            <td>@company.CompanyEmail</td>
        </tr>
            serial++;
        }
    </tbody>
    <tfoot>

    </tfoot>
</table>