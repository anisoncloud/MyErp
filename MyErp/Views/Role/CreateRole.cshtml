@using MyErp.ViewModels;
@model RoleViewModel;
@{
    ViewData["Title"] = "Role Create";
    Layout = "_Layout";
}

<div class="account-container">
    <div class="account-box">
        <div class="col">
            <h2 class="text-center display-6">Create Role</h2>
            <form asp-action="CreateRole" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="RoleName" class="form-label"></label>
                    <input asp-for="RoleName" class="form-control" />
                    <span asp-validation-for="RoleName" class="text-danger"></span>
                </div>
                
                <button type="submit" value="CreateRole" class="btn btn-success w-100 p-2">Create Role</button>
                
                <div class="text-center">
                    <a asp-action="Index" asp-controller="Home" class="text-decoration-none mt-3">Back</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}