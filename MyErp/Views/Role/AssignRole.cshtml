@using Microsoft.AspNetCore.Identity
@model MyErp.ViewModels.UserRoleViewModel


@{
    ViewData["Title"] = "Assign Role";
    Layout = "_Layout";
}




<form asp-action="/" method="post">
    <input type="hidden" asp-for="UserId" />
    @Model.UserId <br />
    @Model.UserName
    @for (int i = 0; i < Model.Roles.Count(); i++)
    {
        <div>
            <input asp-for="Roles[i].Selected" />
            <label>@Model.Roles[i].Text</label>
            <input type="hidden" asp-for="Roles[i].Value" />
        </div>
    }

    <button type="submit">Update Roles</button>
</form>

