@model IEnumerable<MyErp.Models.Lead>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}



<h1>All Leads</h1>
<a asp-action="Create">Lead Create</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Company</th>
        </tr>
    </thead>
    <tbody>
        @{
            var serial = 1;
        }
        @foreach (var company in Model)
        {
            <tr>
                <td>@serial</td>
                <td>@company.Name</td>
                <td>@company.Email</td>
                <td>@company.Comment</td>
                <td>@company.CrmCompanies.Name</td>
            </tr>
            serial++;
        }
    </tbody>
    <tfoot>
    </tfoot>
</table>